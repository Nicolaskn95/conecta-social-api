generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeRole {
  ADMIN
  MANAGER
  VOLUNTEER
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

enum DonationStockAdjustmentReason {
  SPOILAGE
  LOSS
  DAMAGE
  EXPIRATION
  INVENTORY_CORRECTION
  OTHER
}

enum AuditEntityType {
  DONATION
  DONATION_TO_FAMILY
  FAMILY
  EVENT
}

enum AuditActionType {
  CREATE
  UPDATE
  SOFT_DELETE
  STOCK_ADJUSTMENT
  ALLOCATE_TO_FAMILY
  UPDATE_STATUS
  UPDATE_ATTENDANCE
  UPDATE_INSTAGRAM
}

model Employee {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(30)
  surname      String   @db.VarChar(60)
  birth_date   DateTime
  cpf          String   @unique @db.VarChar(11)
  email        String   @unique @db.VarChar(60)
  phone        String   @db.VarChar(15)
  password     String   @db.VarChar(128)

  role         EmployeeRole @default(VOLUNTEER)

  cep          String   @db.VarChar(9)
  street       String   @db.VarChar(100)
  neighborhood String   @db.VarChar(60)
  number       String   @db.VarChar(20)
  city         String   @db.VarChar(30)
  state        String   @db.VarChar(20)
  complement   String?  @db.VarChar(30)

  active       Boolean  @default(true)

  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  logs LogEmployeeEvent[]
  donation_stock_adjustments DonationStockAdjustment[]
  audit_logs AuditLog[]

  @@map("employees")
}

model Event {
  id                   String   @id @default(uuid())
  name                 String   @db.VarChar(100)
  description          String?  @db.VarChar(1000)
  date                 DateTime
  greeting_description String?  @db.VarChar(1000)
  attendance           Int?
  embedded_instagram   String?  @db.Text
  status               EventStatus @default(SCHEDULED)

  street               String   @db.VarChar(100)
  neighborhood         String   @db.VarChar(30)
  number               String   @db.VarChar(20)
  city                 String   @db.VarChar(30)
  state                String   @db.VarChar(20)
  cep                  String   @db.VarChar(9)
  complement           String?  @db.VarChar(30)

  active               Boolean  @default(true)

  updated_at           DateTime @updatedAt
  created_at           DateTime @default(now())
  logs LogEmployeeEvent[]

  @@map("events")
}

model LogEmployeeEvent {
  id          String   @id @default(uuid())
  id_employee String   @db.VarChar(25)
  id_event    String   @db.VarChar(25)
  log_message String   @db.VarChar(100)
  created_at  DateTime @default(now())

  employee Employee @relation(fields: [id_employee], references: [id])
  event    Event    @relation(fields: [id_event], references: [id])

  @@map("log_employee_event")
}

model Family {
  id            String   @id @default(uuid())
  name          String   @db.VarChar(60)
  street        String   @db.VarChar(60)
  number        String   @db.VarChar(20)
  neighborhood  String   @db.VarChar(60)
  city          String   @db.VarChar(30)
  state         String   @db.VarChar(20)
  cep           String   @db.VarChar(9)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  active        Boolean  @default(true)
  donations_to_family DonationToFamily[]

  @@map("families")
}
model Category {
  id             String    @id @default(uuid())
  name           String    @db.VarChar(25)
  measure_unity  String    @db.VarChar(10)
  created_at     DateTime  @default(now())
  active         Boolean   @default(true)

  Donation Donation[]
  @@map("categories")
}

model Donation {
  id               String    @id @default(uuid())
  category_id      String    
  name             String    @db.VarChar(60)
  description      String?   @db.VarChar(250)
  initial_quantity Int       @default(0)
  current_quantity Int       @default(0)
  donator_name     String?   @db.VarChar(90)
  gender           String?   @db.VarChar(10)
  size             String?   @db.VarChar(20)
  image_key           String? @db.VarChar(512)
  image_bucket        String? @db.VarChar(63)
  image_content_type  String? @db.VarChar(100)
  image_original_name String? @db.VarChar(255)
  active           Boolean   @default(true)
  available        Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  
  category         Category  @relation(fields: [category_id], references: [id])
  donations_to_family DonationToFamily[]
  stock_adjustments DonationStockAdjustment[]

  @@map("donations")
}

model DonationToFamily {
  id             String   @id @default(uuid())
  id_donation    String
  id_family      String
  quantity       Int
  update_message String?  @db.VarChar(250)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  active         Boolean  @default(true)

  donation       Donation @relation(fields: [id_donation], references: [id])
  family         Family   @relation(fields: [id_family], references: [id])

  @@index([id_donation])
  @@index([id_family])
  @@map("donations_to_family")
}

model DonationStockAdjustment {
  id                String   @id @default(uuid())
  id_donation       String
  id_employee       String
  delta_quantity    Int
  previous_quantity Int
  new_quantity      Int
  reason            DonationStockAdjustmentReason
  note              String?  @db.VarChar(500)
  created_at        DateTime @default(now())

  donation          Donation @relation(fields: [id_donation], references: [id])
  employee          Employee @relation(fields: [id_employee], references: [id])

  @@index([id_donation, created_at])
  @@index([id_employee, created_at])
  @@map("donation_stock_adjustments")
}

model AuditLog {
  id                String          @id @default(uuid())
  entity_type       AuditEntityType
  entity_id         String          @db.VarChar(64)
  action_type       AuditActionType
  actor_employee_id String?
  actor_role        EmployeeRole?
  message           String          @db.VarChar(250)
  metadata          Json?
  created_at        DateTime        @default(now())

  actor_employee Employee? @relation(fields: [actor_employee_id], references: [id], onDelete: SetNull)

  @@index([entity_type, entity_id, created_at])
  @@index([actor_employee_id, created_at])
  @@index([created_at])
  @@map("audit_logs")
}
